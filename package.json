{
  "name": "calculatrice-scientifique",
  "version": "1.0.0",
  "description": "Calculatrice scientifique de KIBWE ZONGWE Israël",
  "main": "main.js",
  "author": "KIBWE ZONGWE Israël",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis",
    "build:android": "cap sync android"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.3",
    "@capacitor/android": "^7.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.israelzongwe.calculatrice",
    "productName": "Calculatrice Scientifique",
    "directories": {
      "buildResources": "images",
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "images/icon.png",
      "publish": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Calculatrice Scientifique"
    }
  }
}
